{
  "permissions": {
    "deny": [
      "Edit(plan/**)",
      "Write(plan/**)",
      "MultiEdit(plan/**)",
      "Edit(registry/gates/**)",
      "Write(registry/gates/**)",
      "Edit(data/splits/**)",
      "Write(data/splits/**)",
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)",
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(sudo:*)"
    ],
    "allow": [
      "Bash(python3 scripts/*)",
      "Bash(python scripts/*)",
      "Bash(python3 .claude/hooks/*)",
      "Bash(pip install pyyaml:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(ls:*)",
      "Bash(nvidia-smi:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "python3 .claude/hooks/guard_freeze.py" }]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 .claude/hooks/guard_freeze.py" },
          { "type": "command", "command": "python3 .claude/hooks/gate_check.py" }
        ]
      }
    ]
  }
}
